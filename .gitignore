# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# namuna fayli — maxfiy qiymatlarsiz, git'da turishi kerak
!.env.example

# vercel
.vercel

# foydalanuvchi ma'lumotlari eksporti (npm run export:profiles) — shaxsiy
# ma'lumot, hech qachon git'ga tushmasligi kerak
/data

# typescript
*.tsbuildinfo
next-env.d.ts

# lokal worker natijalari (yaratilgan video/rasm) — git'ga tushmasin
/local-worker/output/
/local-worker/__pycache__/
/local-worker/clips/
