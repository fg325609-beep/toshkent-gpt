# ============================================================
# ToshkentGPT — muhit o'zgaruvchilari (namuna).
# Nusxa oling: cp .env.example .env.local  — va qiymatlarni to'ldiring.
# .env* fayllar .gitignore'da — hech qachon GitHub'ga tushmaydi.
# Vercel'da: Project → Settings → Environment Variables.
# ============================================================

# --- Gemini (MAJBURIY) -------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Standart matn modeli. Har bir tarif uchun alohida model berish mumkin.
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_LITE=
# GEMINI_MODEL_PRO=
# GEMINI_MODEL_MAX=
# GEMINI_MODEL_PROMAX=
# Suhbat nomi (arzon, kichik model) va jonli ovozli suhbat uchun model (ixtiyoriy).
# GEMINI_TITLE_MODEL=
# GEMINI_VOICE_MODEL=
# Oddiy suhbatda model o'zi internetdan qidirishi/havola o'qishi — qaysi tariflarda.
# (Google Search grounding alohida narxlanadi; Lite uchun standart o'chiq.)
AUTO_TOOLS_PLANS=pro,max,promax
# Rasm modeli (Max/Pro Max tariflari uchun) va ovoz (TTS) modeli.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# --- Google orqali kirish (MAJBURIY) -----------------------------------
# https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client ID)
# Redirect URI: https://<sayt>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# `npx auth secret` bilan yarating.
AUTH_SECRET=

# --- Redis / Upstash (tariflar, limitlar, profil, admin uchun) -----------
# Vercel Marketplace → "Upstash for Redis" qo'shsangiz o'zi to'ldiriladi.
# Bo'lmasa hamma Lite sifatida, limit/profil saqlanmasdan ishlaydi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (muqobil nomlar: KV_REST_API_URL / KV_REST_API_TOKEN)

# --- Admin paneli (/admin) ----------------------------------------------
ADMIN_EMAIL=
ADMIN_PANEL_PASSWORD=

# --- Telegram ------------------------------------------------------------
# @BotFather'dan olingan token. Webhook: https://<sayt>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
# Bot foydalanuvchi nomi (@siz) — "Telegram bilan bog'lash" havolasi uchun.
TELEGRAM_BOT_USERNAME=
# Admin (to'lov so'rovlari, shikoyatlar, avto-bloklar) uchun chat ID.
TELEGRAM_CHAT_ID=
# setWebhook'da secret_token sifatida bering — begona so'rovlar rad etiladi.
# Ishlab chiqarishda ALBATTA sozlang.
TELEGRAM_WEBHOOK_SECRET=

# --- Push bildirishnomalar (ixtiyoriy) -------------------------------------
# `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel Cron (/api/cron/plan-reminders) uchun maxfiy kalit.
CRON_SECRET=

# --- Katta fayllar (video/audio, 500 MB gacha) — Vercel Blob -----------------
# Vercel → Storage → Blob → "Connect to project" — token o'zi qo'shiladi.
# Bo'lmasa faqat 3 MB gacha fayl (base64) ishlaydi, video/audio yuklanmaydi.
BLOB_READ_WRITE_TOKEN=
# Brauzerdan yuklash chegarasi (MB). Standart 5120 (5 GB, multipart).
# Chatdagi AI tahlili uchun Gemini chegarasi 2 GB; Podkast → klip uchun chegara yo'q.
NEXT_PUBLIC_MAX_UPLOAD_MB=5120

# --- Podkast → klip (lokal worker, /clips/* endpointlari) --------------------
# Qaysi tariflar ishlata oladi (vergul bilan). Standart: max,promax
CLIPS_ALLOWED_PLANS=max,promax
# Worker tomonida: GEMINI_API_KEY, WHISPER_MODEL, CLIPS_DIR — local-worker/README.md

# --- Rasm chizish provayderi (ixtiyoriy) ------------------------------------
# bo'sh  -> Gemini (Max/Pro Max) yoki bepul Pollinations
# local  -> o'z kompyuteringizdagi worker (LOCAL_VIDEO_URL + WORKER_TOKEN)
IMAGE_PROVIDER=
# POLLINATIONS_MODEL=flux
# LOCAL_IMAGE_TIMEOUT_MS=300000

# --- AI video (rasm -> video, faqat Max/Pro Max) ----------------------------
# local -> lokal worker (local-worker/worker.py), fal -> fal.ai
VIDEO_PROVIDER=local
LOCAL_VIDEO_URL=
WORKER_TOKEN=
# FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/stable-video

# --- Boshqalar ---------------------------------------------------------------
# Google Search Console tasdiqlash kodi (ixtiyoriy).
GOOGLE_SITE_VERIFICATION=
