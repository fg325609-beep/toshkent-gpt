+          <button
+            type="button"
+            onClick={copyHook}
+            className="flex items-center justify-center gap-1.5 rounded-xl border border-[var(--tg-border)] px-3 py-2 text-xs font-medium text-[var(--tg-text-2)] transition hover:bg-[var(--tg-hover)]"
