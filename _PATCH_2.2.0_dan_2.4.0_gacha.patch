+[data-theme='light'] .hljs-keyword, [data-theme='light'] .hljs-selector-tag, [data-theme='light'] .hljs-subst, [data-theme='light'] .hljs-meta { color: #8250DF; }
+[data-theme='light'] .hljs-number, [data-theme='light'] .hljs-literal, [data-theme='light'] .hljs-variable, [data-theme='light'] .hljs-template-variable { color: #B45309; }
+[data-theme='light'] .hljs-string, [data-theme='light'] .hljs-doctag, [data-theme='light'] .hljs-regexp, [data-theme='light'] .hljs-addition { color: #15803D; }
+[data-theme='light'] .hljs-title, [data-theme='light'] .hljs-section, [data-theme='light'] .hljs-selector-id, [data-theme='light'] .hljs-title.function_ { color: #B7791F; }
+[data-theme='light'] .hljs-type, [data-theme='light'] .hljs-title.class_, [data-theme='light'] .hljs-built_in { color: #0F766E; }
+[data-theme='light'] .hljs-attr, [data-theme='light'] .hljs-attribute, [data-theme='light'] .hljs-name, [data-theme='light'] .hljs-selector-class { color: #1D4ED8; }
+[data-theme='light'] .hljs-symbol, [data-theme='light'] .hljs-bullet, [data-theme='light'] .hljs-link, [data-theme='light'] .hljs-params { color: #3F4550; }
+
+[data-theme='light'] .tg-scroll::-webkit-scrollbar-thumb {
