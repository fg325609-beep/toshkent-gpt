+async function isDuplicateUpdate(redis, updateId) {
+  if (!redis || updateId === undefined || updateId === null) return false;
+  try {
+    const set = await redis.set(updateSeenKey(updateId), '1', { nx: true, ex: 60 * 60 * 6 });
