+const DESCRIPTION = 'Boshqaruv paneli.';
+
+export const metadata = {
+  title: TITLE,
+  description: DESCRIPTION,
+  robots: { index: false, follow: false },
+  openGraph: {
+    title: `${TITLE} · ToshkentGPT`,
