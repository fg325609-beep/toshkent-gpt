+        return (f"gradients=s={w}x{h}:c0={CLIP_BG_TOP}:c1={CLIP_BG}:x0={w // 2}:y0=0:x1={w // 2}:y1={h}"
+                f":nb_colors=2:speed=0.00001:r={fps}:d={d}")
+    return f"color=c={CLIP_BG}:s={w}x{h}:r={fps}:d={d}"
