+    const interval = setInterval(load, 60000);
+    return () => clearInterval(interval);
+  }, [load]);
+
+  const checks = data?.checks || {};
+  const okCount = HEALTH_CARDS.filter((c) => checks[c.id]?.ok).length;
+  const env = data?.env || {};
