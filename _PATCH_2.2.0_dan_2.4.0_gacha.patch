+              {/* Worker: qurilma / daraja / klip imkoniyatlari */}
+              {card.id === 'worker' && c?.ok && (
+                <div className="mt-0.5 flex flex-wrap gap-1">
+                  {c.device && <Pill>{c.device}</Pill>}
+                  {c.tier && <Pill>tier: {c.tier}</Pill>}
