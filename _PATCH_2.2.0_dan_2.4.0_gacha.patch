+def _hex_to_ass(hex_color, alpha="00"):
+    """'#RRGGBB' -> '&HAABBGGRR' (ASS rang formati)."""
+    h = hex_color.lstrip("#")
+    r, g, b = h[0:2], h[2:4], h[4:6]
+    return f"&H{alpha}{b}{g}{r}".upper()
+
+
+def _ass_time(sec):
+    """Soniya -> ASS vaqt formati H:MM:SS.cc"""
+    sec = max(0.0, float(sec))
+    h = int(sec // 3600)
+    m = int((sec % 3600) // 60)
+    s = sec % 60
+    return f"{h}:{m:02d}:{s:05.2f}"
+
