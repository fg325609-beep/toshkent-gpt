+def _fit_crop(iw, ih, ar):
+    """Manba (iw x ih) ichiga sig'adigan, nisbati `ar` (w/h) bo'lgan eng katta oyna (juft sonlar)."""
+    cw = min(float(iw), float(ih) * ar)
