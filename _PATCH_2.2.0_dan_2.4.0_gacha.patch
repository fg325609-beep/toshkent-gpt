+            borderRadius: 9999,
+            background: 'radial-gradient(circle, rgba(228,169,59,0.35), rgba(228,169,59,0) 70%)',
+            display: 'flex',
+          }}
+        />
+        <div
+          style={{
+            position: 'absolute',
